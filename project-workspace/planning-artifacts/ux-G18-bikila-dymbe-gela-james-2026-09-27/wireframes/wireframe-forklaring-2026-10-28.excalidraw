    {
      "id": "forkl-184",
      "type": "text",
      "x": 2032,
      "y": 212,
      "width": 716.1,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1183,
      "version": 1,
      "versionNonce": 8301,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792540800000,
      "link": null,
      "locked": false,
      "index": "b1x",
      "text": "Kalkulatoren er en læringshjelp. Tallene i kartet, i listen og på stedssidene regnes ut\nautomatisk fra prognosen fra Meteorologisk institutt (i demomodus fra innspilte svar), og det\ndu skriver her, endrer dem ikke.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Kalkulatoren er en læringshjelp. Tallene i kartet, i listen og på stedssidene regnes ut\nautomatisk fra prognosen fra Meteorologisk institutt (i demomodus fra innspilte svar), og det\ndu skriver her, endrer dem ikke.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "forkl-185",
      "type": "text",
      "x": 2032,
      "y": 274,
      "width": 716.1,
      "height": 35,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1184,
      "version": 1,
      "versionNonce": 8308,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792540800000,
      "link": null,
      "locked": false,
      "index": "b1y",
      "text": "Kalkulatoren fordeler nedbøren jevnt over alle 24 timene, med samme temperatur hver time. Den\nstarter på 12 mm og −2,3 °C, som er nedbøren og snittemperaturen i regneeksempelet over.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Kalkulatoren fordeler nedbøren jevnt over alle 24 timene, med samme temperatur hver time. Den\nstarter på 12 mm og −2,3 °C, som er nedbøren og snittemperaturen i regneeksempelet over.",
      "lineHeight": 1.25,
      "autoResize": true
    },
